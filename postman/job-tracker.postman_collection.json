{
  "info": {
    "name": "Job Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create application (applied)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"AIparking\",\n  \"position\": \"Golang Developer Intern\",\n  \"city\": \"Almaty\",\n  \"link\": \"\",\n  \"contact\": \"@dimekenn\",\n  \"notes\": \"написал рекрутеру\",\n  \"status\": \"applied\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('id', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create application (wishlist, default status)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"Kaspi\",\n  \"position\": \"Junior Go Developer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. List all",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. List only applied",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications?status=applied",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications"
          ],
          "query": [
            {
              "key": "status",
              "value": "applied"
            }
          ]
        }
      }
    },
    {
      "name": "6. Get by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Update (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"AIparking\",\n  \"position\": \"Golang Developer Intern\",\n  \"city\": \"Almaty\",\n  \"notes\": \"ответили, ждём тестовое\",\n  \"status\": \"applied\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Change status (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/{{id}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{id}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"interview\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('now interview', () => pm.expect(pm.response.json().status).to.eql('interview'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stats"
          ]
        }
      }
    },
    {
      "name": "10. Delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR: empty company -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"\",\n  \"position\": \"Dev\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR: unknown status -> 400",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/{{id}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{id}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"maybe\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "ERROR: not found -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "9999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}